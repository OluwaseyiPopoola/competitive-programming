"""
204. Count Primes
Given an integer n, return the number of prime numbers that are strictly less than n.
"""

class Solution:
    def countPrimes(self, n: int) -> int:
        if n < 2:
            return 0

        cnt = 0
        isPrime = [True]*n 
        isPrime[0] = isPrime[1] = False

        for i in range(2, int(n**(0.5)) + 1):
            if isPrime[i]:
                mul = i
                while i * mul < n + 1:
                    isPrime[i*mul] = False
                    mul += i

        return cnt
